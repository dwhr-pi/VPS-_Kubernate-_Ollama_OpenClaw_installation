# Inactive proposal. Missing tools FAIL; bootstrap reviewed GitHub sources first.
# Never run untrusted PRs on production/self-hosted infrastructure.
name: Proposed platform gate
on:
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  offline:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
          fetch-depth: 0
      - name: Require reviewed CI tools
        shell: bash
        run: |
          set -euo pipefail
          for tool in shellcheck shfmt yamllint kubeconform kube-linter gitleaks docker kubectl; do
            command -v "$tool" >/dev/null || { echo "Missing reviewed CI tool: $tool"; exit 1; }
          done
      - name: Syntax and formatting
        run: |
          set -euo pipefail
          bash -n install.sh
          bash -n setup_ultimate.sh
          find scripts -name '*.sh' -print0 | xargs -0 -r shellcheck
          find scripts -name '*.sh' -print0 | xargs -0 -r shfmt -d -i 2 -ci
      - name: Offline inventory and fixtures
        run: |
          set -euo pipefail
          python3 -B scripts/quality/repository_audit.py --section registry
          python3 -B scripts/quality/platform_inventory.py > "$RUNNER_TEMP/inventory.json"
          python3 -B tests/test_platform_inventory.py -v
          python3 -B tests/test_platform_review_examples.py -v
      - name: Redacted secret scan
        run: gitleaks git --redact=100 --report-format json --report-path "$RUNNER_TEMP/gitleaks.json" .
      - name: Render and validate, never apply
        run: |
          set -euo pipefail
          yamllint -d relaxed k8s/base k8s/overlays
          docker compose --env-file stacks/llmops-platform/.env.example -f stacks/llmops-platform/docker-compose.yml config --quiet
          docker compose --env-file monitoring/.env.example -f docker-compose.monitoring.yml config --quiet
          for overlay in k8s/base k8s/overlays/production; do
            kubectl kustomize "$overlay" > "$RUNNER_TEMP/rendered.yaml"
            kubeconform -strict -summary "$RUNNER_TEMP/rendered.yaml"
            kube-linter lint "$RUNNER_TEMP/rendered.yaml"
          done
  production-hold:
    needs: offline
    if: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    environment: production
    steps:
      - name: Fail closed until staging and restore evidence are implemented
        run: |
          echo "BLOCKED: require exact artifact digests, verified staging/restore evidence and approval."
          exit 1
