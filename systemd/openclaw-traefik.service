[Unit]
Description=Lokaler nativer Traefik ohne Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=traefik-local
Group=traefik-local
ExecStart=/usr/local/libexec/openclaw-traefik/traefik --configFile=/etc/openclaw-traefik/traefik.yml
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
# Nur Bindung der niedrigen Loopback-Ports, keine Docker-/Hostverwaltung.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
UMask=0077
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
