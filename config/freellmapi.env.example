# Runtime only: ~/.openclaw_ultimate_user_data/env/freellmapi/.env
# GitHub source install does not require this file; the separate native start does.
# This is not sourced as shell code. Only the three active keys below are allowed.
# HOST/PORT/DB paths are enforced by the launcher, not read from this file.
# Required: exactly 64 hex characters from your password manager/local RNG.
# Keep this key with the database backup; never silently rotate it.
ENCRYPTION_KEY=
# Context handoff is opt-in, not a guarantee of preserved reasoning/state.
FREELLMAPI_CONTEXT_HANDOFF=off
# Disable application update discovery; this does NOT disable catalog sync.
FREELLMAPI_UPDATE_CHECK=off
# For CLI clients only; replace via ENV vault when actually needed.
# FREELLMAPI_API_KEY=
