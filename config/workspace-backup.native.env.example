# Nicht source/eval benutzen: diese Datei wird nur als systemd-EnvironmentFile gelesen.
BACKUP_SOURCE=/home/ubuntu/.openclaw_ultimate_user_data
BACKUP_SECRET_DIR=/etc/openclaw-workspace-backup/secrets
BACKUP_HOST_ID=mini-pc-01
RESTIC_BIN=/usr/local/bin/restic
RESTIC_REPOSITORY=s3:https://REPLACE_WITH_S3_ENDPOINT/bucket/mini-pc-01
BACKUP_TARGET_IS_EXTERNAL=0
BACKUP_ALLOW_PRUNE=0
BACKUP_DEDICATED_REPOSITORY=0
