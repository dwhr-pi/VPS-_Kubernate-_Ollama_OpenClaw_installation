# Runtime: ~/.openclaw_ultimate_user_data/env/paperless_ngx/.env (0600)
# Im Passwortmanager lokal erzeugen: je 64 zufaellige Hex-Zeichen, kein Beispielwert.
PAPERLESS_DBPASS=
PAPERLESS_SECRET_KEY=
# Konkrete, zuvor gepruefte numerische Upstream-Version einsetzen, nicht latest.
PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:VERSION_PLACEHOLDER
