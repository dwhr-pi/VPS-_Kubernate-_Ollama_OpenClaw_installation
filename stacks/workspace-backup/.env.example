# Nur Nicht-Secrets. Image muss selbst aus freigegebenen GitHub-Quellen gebaut/geprueft sein.
RESTIC_BACKUP_REPOSITORY=registry.example.invalid/restic-with-bash
RESTIC_BACKUP_SHA256=REPLACE_WITH_VERIFIED_DIGEST
BACKUP_JOB_SCRIPT=/usr/local/libexec/openclaw-backup/backup_user_workspace.sh
USER_WORKSPACE_DIR=/home/ubuntu/.openclaw_ultimate_user_data
BACKUP_SECRET_HOST_DIR=/etc/openclaw-workspace-backup/secrets
BACKUP_HOST_ID=mini-pc-01
RESTIC_REPOSITORY=s3:https://REPLACE_WITH_S3_ENDPOINT/bucket/mini-pc-01
BACKUP_TARGET_IS_EXTERNAL=0
BACKUP_ALLOW_PRUNE=0
BACKUP_DEDICATED_REPOSITORY=0
