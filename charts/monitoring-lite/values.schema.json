{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prometheus": {"$ref": "#/definitions/component"},
    "grafana": {"$ref": "#/definitions/component"},
    "storageClass": {"type": "string", "minLength": 1},
    "retentionTime": {"enum": ["1h", "2h", "6h", "12h", "24h"]},
    "retentionSize": {"enum": ["128MB", "256MB", "512MB"]},
    "nodeExporterTargets": {"$ref": "#/definitions/targets"},
    "ollamaExporterTargets": {"$ref": "#/definitions/targets"},
    "exporterPorts": {"type": "array", "maxItems": 16, "items": {"type": "integer", "minimum": 1024, "maximum": 65535}},
    "exporterCIDRs": {
      "type": "array", "maxItems": 32,
      "items": {"type": "string", "pattern": "^((10\\.[0-9.]+|192\\.168\\.[0-9.]+|172\\.(1[6-9]|2[0-9]|3[01])\\.[0-9.]+)/32|(fc|fd)[a-fA-F0-9:]+/128)$"}
    }
  },
  "definitions": {
    "component": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-zA-Z0-9._:/-]+$"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "authSecret": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "resources": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "requests": {"type": "object", "additionalProperties": {"type": "string"}},
            "limits": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "targets": {"type": "array", "maxItems": 16, "items": {"type": "string", "pattern": "^[^\\s/@]+:[0-9]+$"}}
  }
}
