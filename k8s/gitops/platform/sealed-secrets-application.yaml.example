# Plattform-Admin-App mit CRD/Cluster-RBAC: separat pruefen, nicht im Workload-Projekt.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: sealed-secrets
  namespace: argocd
spec:
  project: REPLACE_WITH_REVIEWED_PLATFORM_PROJECT
  source:
    repoURL: https://github.com/bitnami/sealed-secrets.git
    targetRevision: c58a60f0bd5283d28c25ad068e7c9760634be470
    path: helm/sealed-secrets
    helm:
      releaseName: sealed-secrets
      values: |
        fullnameOverride: sealed-secrets-controller
        resources:
          requests: {cpu: 10m, memory: 32Mi}
          limits: {cpu: 100m, memory: 128Mi}
        image:
          registry: registry.example.invalid
          # Chart setzt repository:tag zusammen; Digest daher im tag per @sha256.
          repository: REPLACE_WITH_REVIEWED_REPOSITORY
          tag: REPLACE_WITH_VERSION_AND_DIGEST
        service: {type: ClusterIP}
        ingress: {enabled: false}
  destination: {server: 'https://kubernetes.default.svc', namespace: kube-system}
  syncPolicy:
    syncOptions: [ApplyOutOfSyncOnly=true]
